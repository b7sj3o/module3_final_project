# Copy to .env.local (no Docker), .env.dev (Docker locally) or .env.production (server).
# Only in .env.dev and .env.production:
# DJANGO_SETTINGS_MODULE=config.settings.dev   # or config.settings.prod

DEBUG=True
# production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/final3

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=final3

SHOP_NAME="Hop & Barley"

# Nova Poshta API 2.0: my.novaposhta.ua -> Settings -> Security -> API keys
NOVA_POSHTA_API_KEY=

# Email. Empty EMAIL_HOST -> letters are printed to the console.
# Resend: EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=re_...
# Without a verified domain Resend sends only from onboarding@resend.dev to your own email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=shop@example.com
SHOP_ADMIN_EMAIL=

# Production only (docker-compose.prod.yml)
# SITE_DOMAIN=shop.example.com       # Caddy gets an HTTPS certificate for it
# SECURE_HSTS_SECONDS=3600           # raise to 31536000 when HTTPS is stable
# WEB_CONCURRENCY=3                  # gunicorn workers
